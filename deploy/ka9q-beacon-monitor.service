[Unit]
Description=KA9Q VHF Beacon Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ka9q
Group=ka9q
WorkingDirectory=/opt/ka9q-beacon-monitor/current
EnvironmentFile=/etc/ka9q-beacon-monitor/runtime.env
ExecStart=/opt/ka9q-beacon-monitor/venv/bin/ka9q-beacon-monitor --config /etc/ka9q-beacon-monitor/runtime.json --factory ka9q_beacon_monitor.deployment_factory:create_app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ka9q-beacon-monitor

[Install]
WantedBy=multi-user.target
