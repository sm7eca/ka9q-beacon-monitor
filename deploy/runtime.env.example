# Non-secret deployment environment example.
# Every uncommented KA9Q_* variable in this file is registered by the
# application. Runtime configuration values are consumed by M5.1; build
# identity values are consumed by M5.2 observability.
#
# The Pi5 no-SDR deployment gets its normal runtime values from runtime.json;
# this EnvironmentFile is therefore intentionally minimal.
KA9Q_API_PORT=8000
KA9Q_BUILD_VERSION=0.1.0
KA9Q_BUILD_REVISION=unknown

# Optional build timestamp (UTC ISO-8601):
# KA9Q_BUILD_TIME_UTC=2026-08-07T00:00:00Z

# Supported non-secret runtime overrides:
# KA9Q_DATABASE_PATH=/var/lib/ka9q-beacon-monitor/beacon-monitor.db
# KA9Q_STATUS_MULTICAST_GROUP=239.0.0.1
# KA9Q_STATUS_PORT=5004
# KA9Q_API_BIND_HOST=0.0.0.0
# KA9Q_WEB_BIND_HOST=0.0.0.0
# KA9Q_WEB_PORT=8000
# KA9Q_WEB_REFRESH_SECONDS=5
# KA9Q_LOG_LEVEL=INFO
# KA9Q_VERIFICATION_ENABLED=false
#
# Secret (inject separately; do not commit a value):
# KA9Q_VERIFICATION_TOKEN=...
